# TMDB (https://developer.themoviedb.org/docs/authentication-application)
# Sem prefixo VITE_ de propósito: o token fica no servidor (api/tmdb na Vercel, proxy do Vite no dev)
# e nunca vai para o JavaScript do navegador. Na Vercel, cadastre em Settings → Environment Variables.
TMDB_READ_TOKEN=

# Alternativa (v3 api_key), se não usar o Read Access Token
# TMDB_API_KEY=

VITE_TMDB_LANGUAGE=pt-BR

# Image base URL (posters/backdrops)
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
