# TMDB API (https://developer.themoviedb.org/docs/authentication-application)
# Use API Read Access Token (Bearer) — recommended
VITE_TMDB_READ_TOKEN=

# Optional fallback (v3 api_key query param) if you don't use Bearer
# VITE_TMDB_API_KEY=

VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_LANGUAGE=pt-BR

# Image base URL (posters/backdrops)
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
